# map login for question 
START

CREATE challengeTitles

FOR EACH challenge

    GET challenge title

    ADD title to challengeTitles

END FOR

RETURN challengeTitles

END

const challengeTitles =
    challenges.map(
        challenge => challenge.questionTitle
    );

#reduce login for score
START

SET totalScore = 0

FOR EACH challenge

    ADD challenge.score TO totalScore

END FOR

RETURN totalScore

END

const totalScore =
    challenges.reduce(
        (sum, challenge) => sum + challenge.score,
        0
    );

# Learner seach
START

DECLARE learners ARRAY

LOAD all learners

INPUT learner name

IF learner name entered THEN

    CREATE matchingLearners array

    FOR EACH learner IN learners

        IF learner.name contains search text THEN

            ADD learner TO matchingLearners

        END IF

    END FOR

    DISPLAY matchingLearners

ELSE

    DISPLAY all learners

END IF

END

# dashboard stats using reduce
START

SET activeLearners = 0

FOR EACH learner IN learners

    IF learner.status = "Active" THEN

        activeLearners = activeLearners + 1

    END IF

END FOR

DISPLAY activeLearners

END

const activeLearners =
    learners.reduce(
        (total, learner) =>
            learner.status === "Active"
                ? total + 1
                : total,
        0
    );