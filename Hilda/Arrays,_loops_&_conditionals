#Arrays, loops & coditionals
START

DECLARE resources ARRAY

resources = [
    {title:"HTML Basics", category:"Web Dev", type:"PDF", size:"2MB"},
    {title:"JavaScript Fundamentals", category:"Software Dev", type:"Video", size:"15MB"},
    {title:"Cyber Awareness", category:"Cybersecurity", type:"Guide", size:"1MB"},
    {title:"Data Visualisation", category:"Data Analytics", type:"Interactive", size:"4MB"}
]

DISPLAY "Learning Resources"

SHOW categories:
    All
    Software Development
    Web Development
    Data Analytics
    Cybersecurity
    General

PROMPT user to select category

STORE selectedCategory

IF selectedCategory = "All" THEN
    filteredResources = resources
ELSE
    filteredResources = FILTER resources
        WHERE resource.category = selectedCategory
END IF

FOR EACH resource IN filteredResources

    DISPLAY resource.title
    DISPLAY resource.type
    DISPLAY resource.size

END FOR

PROMPT user to choose resource

IF resource selected THEN
    OPEN selected resource
ELSE
    DISPLAY "No resource selected"
END IF

END



# my progress
START

DECLARE units ARRAY

units = [
    {name:"HTML Fundamentals", status:"Complete", grade:90},
    {name:"CSS Styling", status:"In Progress", grade:null},
    {name:"JavaScript Basics", status:"Not Started", grade:null}
]

DISPLAY "My Progress"

SET completedCount = 0

FOR EACH unit IN units

    DISPLAY unit.name
    DISPLAY unit.status

    IF unit.grade exists THEN
        DISPLAY unit.grade
    END IF

    IF unit.status = "Complete" THEN
        completedCount = completedCount + 1
    END IF

END FOR

totalUnits = LENGTH(units)

progressPercentage =
(completedCount / totalUnits) * 100

DISPLAY progressPercentage

END



# filter 
START

Array of tasks received

CREATE outstandingTasks list

FOR EACH task IN tasks

    IF task.completed = false THEN

        ADD task TO outstandingTasks

    END IF

END FOR

RETURN outstandingTasks

END

const outstandingTasks =
    tasks.filter(task => task.completed === false);


# map for task titles
START

CREATE taskTitles list

FOR EACH task IN tasks

    ADD task.title TO taskTitles

END FOR

RETURN taskTitles

END

const taskTitles =
    tasks.map(task => task.title);


#reduce for task summary
START

